{
  "name": "@si1ver01/typed-query-state",
  "version": "0.1.0",
  "description": "Type-safe URL query state for browser applications and React.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "RELEASE_NOTES.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./codecs": {
      "types": "./dist/codecs.d.ts",
      "import": "./dist/codecs.js",
      "require": "./dist/codecs.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.18.0",
    "npm": ">=11.16.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0"
  },
  "scripts": {
    "build": "node scripts/run-commands.mjs build tsup",
    "typecheck": "node scripts/run-commands.mjs typecheck tsc --noEmit",
    "test": "node scripts/run-commands.mjs test vitest run",
    "test:watch": "vitest",
    "lint": "node scripts/run-commands.mjs lint eslint src --max-warnings=0",
    "format:check": "prettier . --check",
    "pack:check": "node scripts/check-package.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "security:check": "node scripts/run-commands.mjs security-check node scripts/check-security-dependencies.mjs",
    "release:check-tag": "node scripts/run-commands.mjs release-check-tag node scripts/check-release-tag.mjs",
    "verify": "node scripts/run-commands.mjs verify npm run format:check ::: npm run lint ::: npm run security:check ::: npm run typecheck ::: npm run test ::: npm run build ::: npm run pack:check ::: npm run docs:check"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
